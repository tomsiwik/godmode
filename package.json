{
  "name": "godmode",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test:vitest": "vitest run",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo build && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "prettier": "^3.10.1",
    "turbo": "^2.11.13",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@10.34.9",
  "pnpm": {
    "overrides": {
      "@hey-api/json-schema-ref-parser>js-yaml": "^4.3.2",
      "@ts-morph/common>minimatch": "^11.0.1",
      "esbuild@>=0.27.3 <0.28.1": "^0.28.2",
      "tsx": "^4.23.15"
    },
    "supportedArchitectures": {
      "os": [
        "linux",
        "darwin"
      ],
      "cpu": [
        "x64",
        "arm64"
      ]
    }
  }
}
